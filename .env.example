# ─────────────────────────────────────────────────────────────
#  Backend env vars — set these in your Vercel project
#  (Settings → Environment Variables). All are SERVER-SIDE only:
#  none are prefixed VITE_, so they are never bundled into the
#  browser build.
#
#  For local full-stack dev with `vercel dev`, copy to `.env.local`.
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string (Project → Connect → pooled).
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# The /admin password.
ADMIN_PASSWORD=choose-a-strong-password

# Secret used to sign admin session cookies. Generate one, e.g.:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Vercel Blob (image storage). Auto-injected in Vercel once you connect a Blob
# store to the project — only set this manually for local `vercel dev`.
BLOB_READ_WRITE_TOKEN=
