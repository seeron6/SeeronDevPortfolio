# Supabase — powers the journal + password-locked admin.
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Both are PUBLIC values and safe to ship in
# a static build; write access is protected by Row Level Security + Auth.
#
# Leave these blank to run the site on the built-in seed journal entries.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
